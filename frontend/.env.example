# CloudForge Frontend Environment Variables
# API Gateway Endpoint (Leave empty or set to 'mock' to use Mock/Demo fallback mode)
REACT_APP_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Amazon Cognito Configuration
REACT_APP_USER_POOL_ID=us-east-1_xxxxxxxxx
REACT_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region
REACT_APP_AWS_REGION=us-east-1
VITE_AWS_REGION=us-east-1

# Enable Mock Mode for local offline demo testing (true / false)
VITE_USE_MOCK=false
REACT_APP_USE_MOCK=false
